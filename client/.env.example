# Copy to client/.env.local and fill in.

# Where the Express API runs. The web app proxies /api/* there.
API_URL=http://localhost:4000

# Optional: the same JWT_SECRET as the API. With it, the route guard also checks the token's
# signature and expiry before rendering a page; without it, it only checks the cookie exists
# (the API still verifies every request).
JWT_SECRET=
