# Copy to server/.env and fill in.

# MongoDB connection string: Atlas (mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/tasklane) or local.
MONGODB_URI=mongodb://127.0.0.1:27017/tasklane

# Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Optional
JWT_EXPIRES_IN=7d
PORT=4000
# Extra browser origins allowed to call the API directly, comma-separated.
# Not needed when the web app proxies /api (the default setup).
CORS_ORIGINS=
